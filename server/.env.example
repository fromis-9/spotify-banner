# Optional. Without a token, Puppeteer uses a locally installed browser.
BROWSERLESS_TOKEN=
# Optional path to Chrome when using local Puppeteer.
PUPPETEER_EXECUTABLE_PATH=
# Two units reserved per browser attempt, maximum 40-second browser session.
# Set either limit to 0 to disable browser extraction. Covers remain available.
BROWSER_DAILY_UNIT_LIMIT=20
BROWSER_MONTHLY_UNIT_LIMIT=600
# Use a persistent directory on the deployed server to retain the usage ledger.
# Run one server instance; multiple instances need a shared atomic budget store.
# ARTWORK_CACHE_DIR=/persistent/artwork-cache
PORT=5001

# Optional comma-separated IP addresses/CIDRs of verified reverse proxies.
# Leave unset for direct connections. Never trust arbitrary X-Forwarded-For values.
# TRUSTED_PROXY_CIDRS=
